// BreakBridge — Prisma Schema
// Multi-tenant: Organization → Location → Classroom → Staff
// Entity name: Classroom (never "Room")

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ORGANIZATIONS & TENANCY ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations Location[]
  users     User[]
  userRoles UserRole[]

  @@map("organizations")
}

model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  timezone       String   @default("America/New_York")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classrooms          Classroom[]
  staff               Staff[]
  users               UserLocationAccess[]
  attendanceSnapshots AttendanceSnapshot[]
  breakPlans          BreakPlan[]
  ruleConfigs         RuleConfig[]
  exclusionRules      ExclusionRule[]
  auditEvents         AuditEvent[]
  userRoles           UserRole[]

  @@map("locations")
}

// ─── USERS, ROLES, ACCESS ────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  organizationId String
  supabaseId     String   @unique
  email          String   @unique
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationAccess   UserLocationAccess[]
  userRoles        UserRole[]
  auditEventsActed AuditEvent[]

  @@map("users")
}

// System roles — seeded, not user-created in Phase 1
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  label     String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())

  userRoles UserRole[]

  @@map("roles")
}

// Scoped role assignment: platform-level (no org), org-level, or location-level
model UserRole {
  id             String  @id @default(cuid())
  userId         String
  roleId         String
  organizationId String?
  locationId     String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, organizationId, locationId])
  @@map("user_roles")
}

model UserLocationAccess {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
  @@map("user_location_access")
}

// ─── CLASSROOMS & STAFF ──────────────────────────────────────────────────────

model Classroom {
  id             String   @id @default(cuid())
  locationId     String
  name           String
  label          String
  capacity       Int
  minStaffRatio  Float
  maxKidsPerRoom Int
  isNapRoom      Boolean  @default(false)
  napWindowStart String? // "HH:MM" local time
  napWindowEnd   String? // "HH:MM" local time
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  location         Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  staff            Staff[]
  snapshotEntries  AttendanceSnapshotEntry[]
  breakAssignments BreakAssignment[]
  shiftHints       ShiftHint[]

  @@map("classrooms")
}

model Staff {
  id          String    @id @default(cuid())
  locationId  String
  classroomId String?
  firstName   String
  lastName    String
  displayName String
  role        StaffRole @default(CLASSROOM)
  noBreaks    Boolean   @default(false)
  force30Min  Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  location          Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  classroom         Classroom?                @relation(fields: [classroomId], references: [id])
  snapshotEntries   AttendanceSnapshotEntry[]
  breakAssignments  BreakAssignment[]
  coverageAsBreaker CoverageAssignment[]      @relation("CoverageBreaker")
  exclusionRules    ExclusionRule[]
  shiftHints        ShiftHint[]

  @@map("staff")
}

enum StaffRole {
  CLASSROOM
  BREAKER
  ADMIN_COVER
  NON_CLASSROOM
}

// ─── ATTENDANCE ───────────────────────────────────────────────────────────────

model AttendanceSnapshot {
  id           String   @id @default(cuid())
  locationId   String
  snapshotDate DateTime @db.Date
  rawInput     String?  @db.Text
  importedAt   DateTime @default(now())
  importedBy   String?

  location   Location                  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  entries    AttendanceSnapshotEntry[]
  breakPlans BreakPlan[]

  @@map("attendance_snapshots")
}

model AttendanceSnapshotEntry {
  id          String           @id @default(cuid())
  snapshotId  String
  staffId     String
  classroomId String
  status      AttendanceStatus @default(PRESENT)
  loggedInAt  DateTime?
  loggedOutAt DateTime?
  isCalledOut Boolean          @default(false)
  kidsCount   Int?
  note        String?

  snapshot  AttendanceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  staff     Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classroom Classroom          @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("attendance_snapshot_entries")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  CALLED_OUT
  MISSING
}

// ─── BREAK PLANS ─────────────────────────────────────────────────────────────

model BreakPlan {
  id          String          @id @default(cuid())
  locationId  String
  snapshotId  String?
  planDate    DateTime        @db.Date
  status      BreakPlanStatus @default(DRAFT)
  generatedBy BreakPlanSource @default(MANUAL)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  location            Location             @relation(fields: [locationId], references: [id], onDelete: Cascade)
  snapshot            AttendanceSnapshot?  @relation(fields: [snapshotId], references: [id])
  assignments         BreakAssignment[]
  coverageAssignments CoverageAssignment[]
  exclusionRules      ExclusionRule[]
  exportArtifacts     ExportArtifact[]

  @@map("break_plans")
}

enum BreakPlanStatus {
  DRAFT
  ACTIVE
  FINALIZED
  ARCHIVED
}

enum BreakPlanSource {
  MANUAL
  AUTO_PROPOSED
}

model BreakAssignment {
  id               String                @id @default(cuid())
  breakPlanId      String
  staffId          String
  classroomId      String
  breakStart       String // "HH:MM" local time
  breakEnd         String // "HH:MM" local time
  durationMins     Int
  status           BreakAssignmentStatus @default(PENDING)
  isManualOverride Boolean               @default(false)
  isExcluded       Boolean               @default(false)
  isCalledOut      Boolean               @default(false)
  note             String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  breakPlan          BreakPlan           @relation(fields: [breakPlanId], references: [id], onDelete: Cascade)
  staff              Staff               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classroom          Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  coverageAssignment CoverageAssignment?

  @@map("break_assignments")
}

enum BreakAssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ─── COVERAGE ─────────────────────────────────────────────────────────────────

model CoverageAssignment {
  id                String   @id @default(cuid())
  breakPlanId       String
  breakAssignmentId String   @unique
  breakerStaffId    String
  startTime         String // "HH:MM"
  endTime           String // "HH:MM"
  isManual          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  breakPlan       BreakPlan       @relation(fields: [breakPlanId], references: [id], onDelete: Cascade)
  breakAssignment BreakAssignment @relation(fields: [breakAssignmentId], references: [id], onDelete: Cascade)
  breaker         Staff           @relation("CoverageBreaker", fields: [breakerStaffId], references: [id], onDelete: Cascade)

  @@map("coverage_assignments")
}

// ─── RULES & CONFIG ───────────────────────────────────────────────────────────

model RuleConfig {
  id                String   @id @default(cuid())
  locationId        String   @unique
  breakCutoffTime   String   @default("15:00") // "HH:MM" — no breaks after this
  defaultBreakMins  Int      @default(30)
  minBreakGapMins   Int      @default(30)
  maxBreaksPerStaff Int      @default(1)
  updatedAt         DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("rule_configs")
}

model ExclusionRule {
  id          String   @id @default(cuid())
  locationId  String
  breakPlanId String?
  staffId     String
  reason      String?
  createdAt   DateTime @default(now())

  location  Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  breakPlan BreakPlan? @relation(fields: [breakPlanId], references: [id], onDelete: Cascade)
  staff     Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("exclusion_rules")
}

model ShiftHint {
  id          String   @id @default(cuid())
  staffId     String
  classroomId String
  shiftStart  String? // "HH:MM"
  shiftEnd    String? // "HH:MM"
  dayOfWeek   Int? // 0=Sun … 6=Sat, null=all days
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@map("shift_hints")
}

// ─── AUDIT ────────────────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  locationId String?
  actorId    String?
  entityType String
  entityId   String
  eventType  String
  payload    Json?
  createdAt  DateTime @default(now())

  location Location? @relation(fields: [locationId], references: [id])
  actor    User?     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([locationId, createdAt])
  @@map("audit_events")
}

// ─── EXPORTS ──────────────────────────────────────────────────────────────────

model ExportArtifact {
  id          String       @id @default(cuid())
  breakPlanId String
  format      ExportFormat
  url         String?
  payload     Json?
  createdAt   DateTime     @default(now())

  breakPlan BreakPlan @relation(fields: [breakPlanId], references: [id], onDelete: Cascade)

  @@map("export_artifacts")
}

enum ExportFormat {
  CSV
  JSON_UIPATH
}
