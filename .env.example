# BreakBridge — Environment Variables
# Copy this file to .env.local and fill in values

# Database (auto-provisioned by Replit in development)
DATABASE_URL=postgresql://user:password@localhost:5432/breakbridge

# Supabase Auth (set to "true" to enforce JWT validation in production)
SUPABASE_AUTH_ENFORCE=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis / BullMQ (Phase 2 — leave blank in Phase 1)
REDIS_URL=redis://localhost:6379
